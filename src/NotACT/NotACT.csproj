<Project Sdk="Microsoft.NET.Sdk">

    <!-- Camada que imita o Advanced Combat Tracker para o FFXIV_ACT_Plugin.
         Copiada do IINACT (https://github.com/marzent/IINACT, GPL-3), sem a dependência do Dalamud. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Advanced Combat Tracker</AssemblyName>
        <RootNamespace>Advanced_Combat_Tracker</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <Version>6.9</Version>
        <LangVersion>11</LangVersion>
        <NoWarn>1701;1702;CS8618;IDE1006;CS0067;CS0414;CS0169;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8625;CS8619;CS8620;CS8629;CS8765;CS8767;CS8622;CS8612</NoWarn>
    </PropertyGroup>

    <!-- Referências só de compilação: o motor é baixado e corrigido na máquina de quem usa (ver src/EngineSetup) -->
    <ItemGroup>
        <Reference Include="FFXIV_ACT_Plugin">
            <HintPath>..\..\external_dependencies\FFXIV_ACT_Plugin.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="FFXIV_ACT_Plugin.Logfile">
            <HintPath>..\..\external_dependencies\FFXIV_ACT_Plugin.Logfile.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
